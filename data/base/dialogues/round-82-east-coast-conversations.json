              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r82-follow-the-tide",
                  "status": "completed"
                }
              ]
            },
            {
              "text": "说说青帆埠的水路。",
              "nextNodeId": "routes"
            },
            {
              "text": "改日再谈。",
              "nextNodeId": "farewell"
            }
