{
  "conversations": [
    {
      "id": "dlg.r83-jin-yunfan-provisions",
      "startNodeId": "greet",
      "nodes": [
        {
          "id": "greet",
          "text": "金云帆把几只药罐摆在潮簿旁：「我收的是沿岸行船人的钱，卖的也是沿岸行船人的东西。」",
          "options": [
            {
              "text": "海盐敷膏怎么用？",
              "nextNodeId": "ointment"
            },
            {
              "text": "青帆埠近来有什么动静？",
              "nextNodeId": "harbor"
            },
            {
              "text": "我先看看货。",
              "nextNodeId": "farewell"
            },
            {
              "text": "渡口与青帆之间，有回程班船吗？",
              "nextNodeId": "r126-coastal-service"
            }
          ]
        },
        {
          "id": "ointment",
          "text": "「浅伤先洗净再敷。若伤口深，别拿盐膏硬堵，找郎中看过再说。」"
        },
        {
          "id": "harbor",
          "text": "「顾潮生在查夺网客和暮潮刻线。海盐敷膏每罐26银两，回春膏15，清心丸12；贝壳也在货匣里。相邻按E买货，F打听。两处传航决定会消耗药或贝壳，先留够自己的伤药，没有物资可暂缓，不会凭空赊给你。」"
        },
        {
          "id": "farewell",
          "text": "金云帆将木匣盖好，给后来等船的人让出半张凳子。"
        },
        {
          "id": "r126-coastal-service",
          "text": "渡籍班船只接熟悉两港的客人：先循陆路越云岭到青帆埠，记下港口见闻，班船才开通。雾雨渡口东侧(18,9)、青帆埠码头(88,70)各有船牌，走到邻格按E。每程30银、90世界分钟，报价读完再确认，Esc可取消；落点受阻或银两不足不扣费。原陆路照旧可走，班船没有沿路调查，也不会替你完成护网差事。",
          "options": [
            {
              "text": "明白了，我自行安排。",
              "nextNodeId": "greet"
            }
          ]
        }
      ]
    },
    {
      "id": "dlg.r83-gu-chaosheng-tide-line",
      "startNodeId": "greet",
      "nodes": [
        {
          "id": "greet",
          "text": "顾潮生把一段断开的浮标绳放在膝边：「潮尺记的是水位，可没人把夜里那道回湾线标清。先把潮沟里拖网的人赶走，我再带你认灯。」",
          "options": [
            {
              "text": "我去潮沟找回浮标和网具。",
              "nextNodeId": "recovery-accepted",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r83-net-recovery",
                  "status": "offered"
                }
              ],
              "effects": [
                {
                  "kind": "acceptQuest",
                  "questId": "quest.r83-net-recovery"
                }
              ]
            },
            {
              "text": "夺网客已经击退，浅滩见闻已记。",
              "nextNodeId": "recovery-complete",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r83-net-recovery",
                  "status": "completed"
                }
              ]
            },
            {
              "text": "我去辨认夜里的回湾线。",
              "nextNodeId": "channel-accepted",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r83-night-channel",
                  "status": "offered"
                }
              ],
              "effects": [
                {
                  "kind": "acceptQuest",
                  "questId": "quest.r83-night-channel"
                }
              ]
            },
            {
              "text": "回湾线已经记下了。",
              "nextNodeId": "channel-complete",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r83-night-channel",
                  "status": "completed"
                }
              ]
            },
            {
              "text": "这份补给给岸上救伤，还是留给守标人？",
              "nextNodeId": "r102-supply-choice",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r83-night-channel",
                  "status": "completed"
                },
                {
                  "kind": "knowledgeKnown",
                  "nodeId": "event.r102-supply-settled",
                  "isKnown": false
                }
              ]
            },
            {
              "text": "大陆的刻痕对照，对海路有何用？",
              "nextNodeId": "r102-mainland-link",
              "conditions": [
                {
                  "kind": "knowledgeKnown",
                  "nodeId": "event.r100-paper-crosscheck"
                }
              ]
            },
            {
              "text": "澜心洲的传航办法如何？",
              "nextNodeId": "r102-echo-pilot-public",
              "conditions": [
                {
                  "kind": "knowledgeKnown",
                  "nodeId": "event.r102-pilot-public"
                }
              ]
            },
            {
              "text": "澜心洲的传航办法如何？",
              "nextNodeId": "r102-echo-pilot-crew",
              "conditions": [
                {
                  "kind": "knowledgeKnown",
                  "nodeId": "event.r102-pilot-crew"
                }
              ]
            },
            {
              "text": "补给已交，岸上与守礁人接下来怎样？",
              "nextNodeId": "r102-echo-shore-aid",
              "conditions": [
                {
                  "kind": "knowledgeKnown",
                  "nodeId": "event.r102-shore-aid"
                }
              ]
            },
            {
              "text": "补给已交，岸上与守礁人接下来怎样？",
              "nextNodeId": "r102-echo-keeper-aid",
              "conditions": [
                {
                  "kind": "knowledgeKnown",
                  "nodeId": "event.r102-keeper-aid"
                }
              ]
            },
            {
              "text": "先说说这片潮沟。",
              "nextNodeId": "tidal-flat"
            }
          ]
        },
        {
          "id": "recovery-accepted",
          "text": "「浅滩东边有拖网的脚印，别踩进湿沙里的旧木桩。浮标绳断口还挂着蓝漆。」"
        },
        {
          "id": "recovery-complete",
          "text": "「夺网客已退，浅滩见闻和谢仪已经结算；你身上没有新增网具，浮标也不会自动换样。接下暮潮牵标，在黄昏或入夜调查浅滩石标，再来谈沿海补给。」"
        },
        {
          "id": "channel-accepted",
          "text": "「天色暗下来再找。石标背海的一面有一条刻线，灯影碰到刻线时，浅湾就能绕过外礁。」"
        },
        {
          "id": "channel-complete",
          "text": "「回湾刻线已经记入见闻，谢仪结清。它说明这一段浅湾的辨向，不能凭一条线许诺全海路都安全。由青帆埠东南海口(91,71)到风回岛，再由风回岛东岸关口(97,50)往潮生屿；M舆图可查实际关口。」"
        },
        {
          "id": "tidal-flat",
          "text": "「白日看沙纹只能辨风，天黑后才看得出潮沟怎么转。两样都要记，才算真懂这段海岸。」"
        },
        {
          "id": "r102-supply-choice",
          "confirmEffects": true,
          "text": "这份补给给岸上救伤，还是留给守标人？",
          "options": [
            {
              "text": "给岸上救伤留海盐敷膏1罐（顾+4、岑−3、声望+2）",
              "nextNodeId": "r102-shore-aid",
              "conditions": [
