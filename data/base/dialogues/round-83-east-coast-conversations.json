                }
              ]
            },
            {
              "text": "给守礁药囊留回春膏1份（顾−3、岑+4、声望−1）",
              "nextNodeId": "r102-keeper-aid",
              "conditions": [
                {
                  "kind": "knowledgeKnown",
                  "nodeId": "event.r102-supply-settled",
                  "isKnown": false
