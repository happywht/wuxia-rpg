                  "nodeId": "event.r102-shore-aid"
                }
              ]
            },
            {
              "text": "青帆埠的补给决定，你如何看？",
              "nextNodeId": "r102-echo-keeper-aid",
              "conditions": [
                {
                  "kind": "knowledgeKnown",
                  "nodeId": "event.r102-keeper-aid"
                }
              ]
            },
            {
              "text": "这件差事对你意味着什么？",
              "nextNodeId": "r105-before",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r85-low-tide-channel",
                  "status": "locked"
                }
              ]
            },
            {
              "text": "这件差事对你意味着什么？",
              "nextNodeId": "r105-before",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r85-low-tide-channel",
                  "status": "offered"
                }
              ]
            },
            {
              "text": "这件差事对你意味着什么？",
              "nextNodeId": "r105-active",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r85-low-tide-channel",
                  "status": "active"
                }
              ]
            },
            {
              "text": "这件差事对你意味着什么？",
              "nextNodeId": "r105-after",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r85-low-tide-channel",
                  "status": "completed"
                }
