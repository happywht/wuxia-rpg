      "nodes": [
        {
          "id": "greet",
          "text": "谷照雪把松明捆上燧杆：「雁候看季节，烽号报当下。有人学了火号向客商索路钱，你既肯点验，也得把燧台东南那伙冒号客赶开，再来复命。谢仪只有经验、银两和见闻，不送烈酒。」",
          "options": [
            {
              "text": "燧书我点。",
              "nextNodeId": "accepted",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r92-snow-beacon",
                  "status": "offered"
                }
              ],
              "effects": [
                {
                  "kind": "acceptQuest",
                  "questId": "quest.r92-snow-beacon"
                }
              ]
            },
            {
              "text": "燧书已经验回来了。",
              "nextNodeId": "completed",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r92-snow-beacon",
                  "status": "completed"
                }
              ]
            },
            {
              "text": "我正要上燧点验。",
              "nextNodeId": "active",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r92-snow-beacon",
                  "status": "active"
                }
              ]
            },
            {
              "text": "烽燧怎么走？",
              "nextNodeId": "route"
            },
            {
              "text": "你在关里守什么？",
              "nextNodeId": "keeper"
            },
            {
              "text": "烽号核妥，番号要传给所有过路人吗？",
              "nextNodeId": "r101-code-choice",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r92-snow-beacon",
                  "status": "completed"
                },
                {
                  "kind": "knowledgeKnown",
