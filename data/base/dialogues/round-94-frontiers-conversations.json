              "nextNodeId": "route"
            },
            {
              "text": "四地复核与立场都已定，下一章怎样接海路？",
              "nextNodeId": "r101-north-close",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r91-goose-vigil",
