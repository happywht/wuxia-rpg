      "nodes": [
        {
          "id": "greet",
          "text": "沈问秋把一叠被风雪磨卷的旧驿牒压在石桌上：「东脊新开的天门关，如今只剩烽台石刻能告诉我们山外的旧路。你沿路去拓一份回来，我便敢给关门添上一笔新记。」",
          "options": [
            {
              "text": "我去看看烽台。",
              "nextNodeId": "accepted",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r94-snowline-signal",
                  "status": "offered"
                }
              ],
              "effects": [
