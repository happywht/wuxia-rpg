      "nodes": [
        {
          "id": "greet",
          "text": "赵千帆蹲在归帆洲南码头，把一盏裂了边的旧灯罩转了半圈：「岛东那盏灯近来照得不对，浪高时看不出回港的方向。你去礁岸按刻线核一下，回来告诉我该往哪边偏舵。」",
          "options": [
            {
              "text": "我去礁岸核灯。",
              "nextNodeId": "accepted",
              "conditions": [
                {
