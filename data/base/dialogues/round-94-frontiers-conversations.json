            {
              "text": "我正在找灯标。",
              "nextNodeId": "active",
              "conditions": [
                {
                  "kind": "questStatus",
                  "questId": "quest.r94-homeward-lantern",
                  "status": "active"
                }
              ]
            },
            {
              "text": "灯标怎么走？",
