    { "id": "kg.edge.dianjin-bi-belongs-hanshan", "fromId": "skill.r32-hanshan-dianjin-bi", "toId": "faction.hanshan-shuyuan", "relation": "belongsTo", "summary": "点津校脉笔属寒山书院，以笔锋校正腕肘角度让对手力道落空。" },
