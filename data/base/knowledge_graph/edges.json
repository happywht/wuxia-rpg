    { "id": "kg.edge.jinglun-xinfa-belongs-hanshan", "fromId": "skill.r32-hanshan-jinglun-xinfa", "toId": "faction.hanshan-shuyuan", "relation": "belongsTo", "summary": "经纶定息篇是寒山书院循序养气法，呼吸分四段，抄录盟书时默记节拍。" },
    { "id": "kg.edge.dingli-jue-belongs-hanshan", "fromId": "skill.r32-hanshan-dingli-jue", "toId": "faction.hanshan-shuyuan", "relation": "belongsTo", "summary": "定理贯脉诀是寒山书院高阶守中内篇，辨清气血逆顺再以长息贯脉。" },
