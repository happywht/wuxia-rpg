    { "id": "kg.edge.huiyang-jue-belongs-yunyin", "fromId": "skill.r32-yunyin-huiyang-jue", "toId": "faction.yunyin-shanzhuang", "relation": "belongsTo", "summary": "回阳引气诀是山庄护送行功法，先收气息回丹田再送往受伤处。" },
    { "id": "kg.edge.luqiang-shenfa-belongs-yunyin", "fromId": "skill.r32-yunyin-luqiang-shenfa", "toId": "faction.yunyin-shanzhuang", "relation": "belongsTo", "summary": "露墙穿枝步是山庄林间高阶步法，穿过枝隙立即转身，不把背门留给追兵。" },
