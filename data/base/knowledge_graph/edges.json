    { "id": "kg.edge.jiang-holds-huichun-gao", "fromId": "char.jiang-baiwei", "toId": "item.huichun-gao", "relation": "holds", "summary": "回春膏是货担常备的黑膏伤药，不限量供应，走江湖的保命底货。" },
    { "id": "kg.edge.jiang-holds-qingxin-wan", "fromId": "char.jiang-baiwei", "toId": "item.qingxin-wan", "relation": "holds", "summary": "清心丸每趟只上五枚，卖完须等他回程补货。" },
