    { "id": "kg.edge.shishou-tui-belongs-tiezhang", "fromId": "skill.r32-tiezhang-shishou-tui", "toId": "faction.tiezhang-pai", "relation": "belongsTo", "summary": "十手推碑腿是铁嶂派高阶破阵腿法，十连推蹬拆架、末腿取中门。" },
    { "id": "kg.edge.yunyin-shenfa-belongs-yunyin", "fromId": "skill.yunyin-shenfa", "toId": "faction.yunyin-shanzhuang", "relation": "belongsTo", "summary": "云隐身法是山庄轻身功夫，提气纵跃落地无声，采药避兽保命脱身皆用。" },
    { "id": "kg.edge.caomu-xinfa-belongs-yunyin", "fromId": "skill.r32-yunyin-caomu-xinfa", "toId": "faction.yunyin-shanzhuang", "relation": "belongsTo", "summary": "草木回息篇是云隐山庄的基础调养心法，配合四时草木吐纳不催不迫。" },
    { "id": "kg.edge.buyun-lu-belongs-yunyin", "fromId": "skill.r32-yunyin-buyun-lu", "toId": "faction.yunyin-shanzhuang", "relation": "belongsTo", "summary": "步云履是山庄沿山采药步法，落足总选在草木受力最稳处。" },
