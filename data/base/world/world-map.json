  "events": [
    {
      "id": "event.ferry-first-arrival",
      "mapResourceId": "map.round-10-mist-ferry",
      "col": 1,
      "row": 4,
      "text": "渡口边留着一行新鲜脚印，雨水还没有将它们冲散。",
      "once": true,
      "discoverKnowledgeNodeId": "event.old-footprints"
    },
    {
      "id": "event.trial-cloudbreak",
      "mapResourceId": "map.round-01-grid",
      "col": 43,
      "row": 36,
      "text": "云隙投下一束日光，石面上的旧刻痕清晰起来。",
      "once": true
    },
    {
      "id": "event.reedbank-traces",
      "mapResourceId": "map.round-10-mist-ferry",
      "col": 5,
      "row": 4,
      "text": "沿着脚印走到芦苇边，泥面下露出一截被水草缠住的旧桩。渡船人认得那是废船道留下的系缆桩。",
      "once": true,
      "conditions": {
        "knowledgeNodeIds": ["event.old-footprints"],
        "periodIds": ["period.dusk", "period.night"],
        "weatherIds": ["weather.drizzle", "weather.rain", "weather.storm"]
      },
      "discoverKnowledgeNodeId": "place.reedbank"
    },
    {
      "id": "event.r55-sluice-inscription",
      "mapResourceId": "map.round-10-mist-ferry",
      "col": 46,
      "row": 53,
      "text": "石闸背水的一面刻着数道潮尺。最深的一痕旁，还留着旧船号的半个‘芦’字；枯水时，窄槽能把南湾的浅舟引回渡镇。",
      "once": true,
      "discoverKnowledgeNodeId": "place.mist-sluice"
    },
    {
      "id": "event.r56-north-water-gauge",
      "mapResourceId": "map.round-10-mist-ferry",
      "col": 86,
      "row": 15,
      "text": "雾气散开时，北岸石桩露出半截潮尺。石北留下的旧拓片与刻痕相合，水尺尽头正是雾岬林地。",
      "once": true,
      "discoverKnowledgeNodeId": "place.mist-north-cap"
    },
    {
      "id": "event.r56-south-waterway-mark",
      "mapResourceId": "map.round-10-mist-ferry",
      "col": 81,
      "row": 87,
      "text": "苇根间埋着一块斜立的旧水标。刮去泥皮后，刻线与石闸潮尺首尾相接，标出通往南湾的浅槽。",
      "once": true,
      "discoverKnowledgeNodeId": "place.mist-south-pool"
    },
    {
      "id": "event.r58-market-first-visit",
      "mapResourceId": "map.round-10-mist-ferry",
      "col": 59,
      "row": 65,
      "text": "河湾旧棚下挂着半幅褪色的芦字幌子，边上还留着船号刻痕。比过旧渠碑上的残字后，渡口人认出这里便是早年歇脚开市的芦桥集。",
      "once": true,
      "discoverKnowledgeNodeId": "place.mist-willow-market"
    },
    {
      "id": "event.r58-south-hamlet-arrival",
      "mapResourceId": "map.round-01-grid",
      "col": 70,
      "row": 75,
      "text": "山脚一排排竹匾正晾着新采的茶叶，村口石阶沿旧驿道向南折去。马尚义托人问过的南麓聚落，就在这片坡地尽头。",
      "once": true,
      "discoverKnowledgeNodeId": "place.south-hamlet"
    }
  ],
  "randomEvents": [
    {
      "id": "event.r43-wayfarer-letter",
      "mapResourceId": "map.round-10-mist-ferry",
      "text": "黄昏雨脚里，一个赶路人将五封各带不同门派暗记的求助信交给你。他说五派都在寻一双走过芦苇岸的脚，愿你代为核问；信上没有署名。",
      "once": true,
      "chance": 0.12,
      "conditions": {
        "knowledgeNodeIds": ["event.old-footprints"],
        "periodIds": ["period.dusk", "period.night"],
        "weatherIds": ["weather.drizzle", "weather.rain", "weather.storm"]
      },
      "discoverKnowledgeNodeId": "event.r43-wayfarer-letter"
    },
    {
      "id": "event.r44-dock-claim",
      "mapResourceId": "map.round-10-mist-ferry",
      "text": "黄昏雨雾间，石北与白鹭洲正为一根旧系缆桩争执：一人要先打铁楔，一人要先核对渡簿中的船期。两人都不肯让这一步，却都没有急着定谁对谁错。",
      "once": true,
      "chance": 0.35,
      "conditions": {
        "knowledgeNodeIds": ["event.r43-wayfarer-letter"],
