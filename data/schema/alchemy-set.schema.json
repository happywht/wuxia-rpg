{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuxia-rpg.invalid/schema/alchemy-set",
  "title": "炼药工位与药方集合",
  "description": "声明地图炼药工位、需要先发现的药方、药材成本、悟性品质门槛及普通消耗品结果。跨资源引用和品质单调性由装配层检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["stations", "recipes"],
  "properties": {
    "stations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "mapResourceId", "position"],
        "properties": {
          "id": { "type": "string", "pattern": "^alchemy\\.station\\.[A-Za-z0-9._-]+$", "maxLength": 96 },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "mapResourceId": { "type": "string", "pattern": "^map\\.[A-Za-z0-9._-]+$", "maxLength": 96 },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": ["col", "row"],
            "properties": {
              "col": { "type": "integer", "minimum": 0, "maximum": 255 },
              "row": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        }
      }
    },
    "recipes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "discoveryHint", "discoveryNodeId", "stationId", "ingredients", "currencyCost", "outcomes"],
        "properties": {
          "id": { "type": "string", "pattern": "^alchemy\\.recipe\\.[A-Za-z0-9._-]+$", "maxLength": 96 },
          "name": { "type": "string", "minLength": 1, "maxLength": 48 },
          "description": { "type": "string", "minLength": 1, "maxLength": 180 },
          "discoveryHint": { "type": "string", "minLength": 1, "maxLength": 120 },
          "discoveryNodeId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 96 },
          "stationId": { "type": "string", "pattern": "^alchemy\\.station\\.[A-Za-z0-9._-]+$", "maxLength": 96 },
          "ingredients": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["itemId", "quantity"],
              "properties": {
                "itemId": { "type": "string", "pattern": "^item\\.[A-Za-z0-9._-]+$", "maxLength": 96 },
                "quantity": { "type": "integer", "minimum": 1, "maximum": 99 }
              }
            }
          },
          "currencyCost": { "type": "integer", "minimum": 1, "maximum": 999999 },
          "outcomes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "minimumInsight", "resultItemId"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 24 },
                "minimumInsight": { "type": "integer", "minimum": 0, "maximum": 999 },
                "resultItemId": { "type": "string", "pattern": "^item\\.[A-Za-z0-9._-]+$", "maxLength": 96 }
              }
            }
          }
        }
      }
    }
  }
}
