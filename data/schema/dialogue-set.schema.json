{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuxia-rpg.invalid/schema/dialogue-set",
  "title": "对话集合",
  "description": "对话集合 JSON 的静态结构契约：字段名、类型与长度。静态 Schema 违规由资源加载器拒绝。图语义和条件上下界由运行时逐段校验；单段坏对话只禁用自身。选项可声明 conditions（全部满足才可见）与 effects（确认时原子执行）；条件/效果 kind 与字段为封闭枚举。任务/物品/NPC/见闻/门派/武学引用在装配期校验，坏引用只剔除相应选项。拜师、授艺与退门沿用同一事务协议。",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversations"],
  "properties": {
    "conversations": {
      "type": "array",
      "description": "对话条目列表；允许空数组。id 在集合内应保持唯一。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startNodeId", "nodes"],
        "properties": {
          "id": {
            "description": "稳定对话 id，建议前缀 dlg.，如 dlg.shen-mohan-bookshop。",
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*$"
          },
          "startNodeId": {
            "description": "进入对话时显示的首节点 id，须存在于本对话的 nodes 中。",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": {
                  "description": "对话内局部节点 id，如 greet。",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "text": {
                  "description": "节点台词文本；结束节点同样有 text。",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "options": {
                  "type": "array",
                  "description": "玩家可选分支；省略或空数组表示结束节点。",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text", "nextNodeId"],
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "nextNodeId": {
                        "description": "选择后进入的节点 id，须存在于本对话的 nodes 中。",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "conditions": {
                        "type": "array",
                        "description": "全部满足时该选项才可见；省略表示无条件。空数组无意义、被拒绝。",
                        "minItems": 1,
                        "items": { "$ref": "#/definitions/condition" }
                      },
                      "effects": {
                        "type": "array",
                        "description": "确认该选项时原子执行的效果（先全量校验后统一提交，任一失败不转移节点、不产生部分变更）；省略表示纯跳转。空数组无意义、被拒绝。",
                        "minItems": 1,
                        "items": { "$ref": "#/definitions/effect" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "condition": {
      "oneOf": [
        {
          "description": "指定任务处于该状态时成立。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "questId", "status"],
          "properties": {
            "kind": { "const": "questStatus" },
            "questId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "status": { "enum": ["locked", "offered", "active", "completed", "failed"] }
          }
        },
        {
          "description": "背包内指定物品数量不少于 minCount 时成立。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "itemId", "minCount"],
          "properties": {
            "kind": { "const": "itemCount" },
            "itemId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "minCount": { "type": "integer", "minimum": 1, "maximum": 999 }
          }
        },
        {
          "description": "玩家善恶值位于闭区间 [minValue, maxValue]（-100 至 100，正为善名）；minValue/maxValue 至少声明其一。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "morality" },
            "minValue": { "type": "integer", "minimum": -100, "maximum": 100 },
            "maxValue": { "type": "integer", "minimum": -100, "maximum": 100 }
          },
          "anyOf": [{ "required": ["minValue"] }, { "required": ["maxValue"] }]
        },
        {
          "description": "玩家声望位于闭区间 [minValue, maxValue]（0 至 1000）；至少声明其一。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "renown" },
            "minValue": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "maxValue": { "type": "integer", "minimum": 0, "maximum": 1000 }
          },
          "anyOf": [{ "required": ["minValue"] }, { "required": ["maxValue"] }]
        },
        {
          "description": "玩家在指定门派的声望位于闭区间 [minValue, maxValue]（0 至 1000）；至少声明其一。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "factionId"],
          "properties": {
            "kind": { "const": "factionRenown" },
            "factionId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "minValue": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "maxValue": { "type": "integer", "minimum": 0, "maximum": 1000 }
          },
          "anyOf": [{ "required": ["minValue"] }, { "required": ["maxValue"] }]
        },
        {
          "description": "与指定 NPC 的关系值位于闭区间 [minValue, maxValue]（-100 至 100）；至少声明其一。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "npcId"],
          "properties": {
            "kind": { "const": "npcRelationship" },
            "npcId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "minValue": { "type": "integer", "minimum": -100, "maximum": 100 },
            "maxValue": { "type": "integer", "minimum": -100, "maximum": 100 }
          },
          "anyOf": [{ "required": ["minValue"] }, { "required": ["maxValue"] }]
        },
        {
          "description": "玩家已获知指定知识节点时成立。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodeId"],
          "properties": {
            "kind": { "const": "knowledgeKnown" },
            "nodeId": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        {
          "description": "玩家属于或不属于指定门派；省略 factionId 时检查是否加入任意门派。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "isMember"],
          "properties": {
            "kind": { "const": "factionMembership" },
            "factionId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "isMember": { "type": "boolean" }
          }
        },
        {
          "description": "玩家尚未掌握且满足指定武学的等级、属性与门派要求时成立。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "martialArtId"],
          "properties": {
            "kind": { "const": "martialArtEligible" },
            "martialArtId": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        {
          "description": "游戏内当前时段等于历法声明的 periodId 时成立（时段随移动/旅行/等候推进）。periodId 在装配期对照日历校验，坏引用只剔除相应选项。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "periodId"],
          "properties": {
            "kind": { "const": "timeOfDay" },
            "periodId": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "description": "接取任务（要求其当前为 offered）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "questId"],
          "properties": {
            "kind": { "const": "acceptQuest" },
            "questId": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        {
          "description": "放弃任务（要求其当前为 active，终态记为 failed）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "questId"],
          "properties": {
            "kind": { "const": "abandonQuest" },
            "questId": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        {
          "description": "给予玩家物品（校验背包容量后入库）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "itemId", "quantity"],
          "properties": {
            "kind": { "const": "giveItem" },
            "itemId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "quantity": { "type": "integer", "minimum": 1, "maximum": 99 }
          }
        },
        {
          "description": "从玩家背包扣除物品（校验数量；装备中的唯一实例不可被对话收走）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "itemId", "quantity"],
          "properties": {
            "kind": { "const": "takeItem" },
            "itemId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "quantity": { "type": "integer", "minimum": 1, "maximum": 99 }
          }
        },
        {
          "description": "修善良恶值（-100 至 100，非零；结果按边界钳制）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "delta"],
          "properties": {
            "kind": { "const": "adjustMorality" },
            "delta": {
              "allOf": [
                { "type": "integer", "minimum": -100, "maximum": 100 },
                { "not": { "enum": [0] } }
              ]
            }
          }
        },
        {
          "description": "修改声望（-1000 至 1000，非零；结果按边界钳制）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "delta"],
          "properties": {
            "kind": { "const": "adjustRenown" },
            "delta": {
              "allOf": [
                { "type": "integer", "minimum": -1000, "maximum": 1000 },
                { "not": { "enum": [0] } }
              ]
            }
          }
        },
        {
          "description": "修改指定门派的独立声望（-1000 至 1000，非零；结果按边界钳制）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "factionId", "delta"],
          "properties": {
            "kind": { "const": "adjustFactionRenown" },
            "factionId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "delta": {
              "allOf": [
                { "type": "integer", "minimum": -1000, "maximum": 1000 },
                { "not": { "enum": [0] } }
              ]
            }
          }
        },
        {
          "description": "修改与 NPC 的关系值（-100 至 100，非零；结果按边界钳制）；省略 npcId 时作用于当前对话对象。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "delta"],
          "properties": {
            "kind": { "const": "adjustRelationship" },
            "npcId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "delta": {
              "allOf": [
                { "type": "integer", "minimum": -100, "maximum": 100 },
                { "not": { "enum": [0] } }
              ]
            }
          }
        },
        {
          "description": "将已验证的知识节点加入玩家见闻，并在反馈中显示其标题。已知节点重复发现时不重复入档。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodeId"],
          "properties": {
            "kind": { "const": "discoverKnowledgeNode" },
            "nodeId": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        {
          "description": "由当前对话对象（门派登记的师父）收徒；校验门派入门条件并记录师父关系。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "factionId"],
          "properties": {
            "kind": { "const": "joinFaction" },
            "factionId": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        {
          "description": "按当前门派资料声明的规则退门，原子结算声望/善恶并清除师承。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "leaveFaction" } }
        },
        {
          "description": "向有效角色授予一门已满足等级、属性及当前门派资格的武学。",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "martialArtId"],
          "properties": {
            "kind": { "const": "learnMartialArt" },
            "martialArtId": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      ]
    }
  }
}
