{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuxia-rpg.invalid/schema/faction-set",
  "title": "门派集合",
  "description": "门派集合 JSON 的静态结构契约：设定、导师、入门门槛与退门后果全部由数据声明。导师 NPC 与前置任务是否存在、重复门派 id 及被武学引用的可达性由运行时装配补足。拜师、授艺与退门效果由通用对话运行时执行。",
  "type": "object",
  "additionalProperties": false,
  "required": ["factions"],
  "properties": {
    "factions": {
      "type": "array",
      "description": "门派条目列表；允许空数组表达暂无门派资料。id 在集合内应保持唯一。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "stance", "philosophy", "martialStyle"],
        "properties": {
          "id": {
            "description": "稳定门派 id，建议前缀 faction.，如 faction.tingyu-jiange。",
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*$"
          },
          "name": {
            "description": "门派显示名称（原创门派名）。",
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "stance": {
            "description": "立场描述：所在地域、出身构成与江湖态度。",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "philosophy": {
            "description": "宗旨表述：门训或行事准则。",
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "martialStyle": {
            "description": "武学风格说明：与武学类别/门槛相呼应的路数描述。",
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "mentorNpcIds": {
            "description": "可在对话中正式收徒的导师 NPC id；省略时该门派仅作设定资料。",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "admission": {
            "description": "可选入门条件；每一项都必须满足。省略字段按无额外门槛处理。",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimumLevel": { "type": "integer", "minimum": 1, "maximum": 99 },
              "minimumAttributes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "body": { "type": "integer", "minimum": 1, "maximum": 999 },
                  "force": { "type": "integer", "minimum": 1, "maximum": 999 },
                  "agility": { "type": "integer", "minimum": 1, "maximum": 999 },
                  "insight": { "type": "integer", "minimum": 1, "maximum": 999 },
                  "resolve": { "type": "integer", "minimum": 1, "maximum": 999 }
                }
              },
              "minimumMorality": { "type": "integer", "minimum": -100, "maximum": 100 },
              "maximumMorality": { "type": "integer", "minimum": -100, "maximum": 100 },
              "minimumRenown": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "minimumFactionRenown": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "minimumTeacherRelationship": { "type": "integer", "minimum": -100, "maximum": 100 },
              "requiredQuestIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 64 }
              }
            }
          },
          "departure": {
            "description": "可选退门规则；省略表示允许退门、无数值代价并保留门派武学。",
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed", "moralityDelta", "renownDelta", "forgetFactionMartialArts"],
            "properties": {
              "allowed": { "type": "boolean" },
              "moralityDelta": { "type": "integer", "minimum": -100, "maximum": 100 },
              "renownDelta": { "type": "integer", "minimum": -1000, "maximum": 1000 },
              "factionRenownDelta": { "type": "integer", "minimum": -1000, "maximum": 1000 },
              "forgetFactionMartialArts": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
