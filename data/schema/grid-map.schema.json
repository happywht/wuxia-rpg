{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuxia-rpg.invalid/schema/grid-map",
  "title": "网格地图",
  "description": "网格地图 JSON 的静态结构契约：字段名、类型、取值范围。跨字段语义（grid 行数等于 rows、每行长度等于 columns、字符必须在 tileTypes 中、playerStart 落在可走格）由 src/engine/grid-map.ts 的 parseGridMap 在运行时补足。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "tileSize", "columns", "rows", "tileTypes", "grid", "playerStart"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tileSize": {
      "type": "integer",
      "minimum": 8,
      "maximum": 256
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "tileTypes": {
      "type": "object",
      "minProperties": 1,
      "description": "单字符 tile 种类定义；键即 grid 中使用的字符。",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["color", "solid"],
        "properties": {
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "solid": {
            "type": "boolean"
          }
        }
      }
    },
    "grid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "playerStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["col", "row"],
      "properties": {
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
