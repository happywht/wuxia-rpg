{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuxia-rpg.invalid/schema/grid-map",
  "title": "网格地图",
  "description": "网格地图 JSON 的静态结构契约：字段名、类型、取值范围。跨字段语义（grid 行数等于 rows、每行长度等于 columns、字符必须在 tileTypes 中、playerStart 落在可走格）由 src/engine/grid-map.ts 的 parseGridMap 在运行时补足。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "tileSize", "columns", "rows", "tileTypes", "grid", "playerStart"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tileSize": {
      "type": "integer",
      "minimum": 8,
      "maximum": 256
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "tileTypes": {
      "type": "object",
      "minProperties": 1,
      "description": "单字符 tile 种类定义；键即 grid 中使用的字符。",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["color", "solid"],
        "properties": {
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "solid": {
            "type": "boolean"
          }
        }
      }
    },
    "grid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "playerStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["col", "row"],
      "properties": {
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "art": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tileSize", "tilesets", "layers", "actors"],
      "description": "可选像素图集与 Tiled 风格图层；移动阻挡仍由 grid 唯一决定。",
      "properties": {
        "tileSize": { "type": "integer", "minimum": 1, "maximum": 256 },
        "tilesets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "image", "tileSize", "columns", "rows", "spacing", "tileCount"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "image": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
              "tileSize": { "type": "integer", "minimum": 1, "maximum": 256 },
              "columns": { "type": "integer", "minimum": 1, "maximum": 1024 },
              "rows": { "type": "integer", "minimum": 1, "maximum": 1024 },
              "spacing": { "type": "integer", "minimum": 0, "maximum": 32 },
              "tileCount": { "type": "integer", "minimum": 1, "maximum": 1048576 }
            }
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "tilesetId", "cells"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "tilesetId": { "type": "string", "minLength": 1 },
              "depthSort": { "description": "可选：按地图行切片绘制，与人物脚底共同排序。", "enum": ["y"] },
              "cells": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
                }
              }
            }
          }
        },
        "actors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tilesetId", "playerFrame", "defaultNpcFrame"],
          "properties": {
            "tilesetId": { "type": "string", "minLength": 1 },
            "playerFrame": { "type": "integer", "minimum": 0, "maximum": 1048575 },
            "defaultNpcFrame": { "type": "integer", "minimum": 0, "maximum": 1048575 },
            "playerFrames": {
              "type": "object",
              "additionalProperties": false,
              "required": ["idle", "walk"],
              "properties": {
                "idle": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["down", "left", "right", "up"],
                  "properties": {
                    "down": { "type": "integer", "minimum": 0, "maximum": 1048575 },
                    "left": { "type": "integer", "minimum": 0, "maximum": 1048575 },
                    "right": { "type": "integer", "minimum": 0, "maximum": 1048575 },
                    "up": { "type": "integer", "minimum": 0, "maximum": 1048575 }
                  }
                },
                "walk": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["down", "left", "right", "up"],
                  "properties": {
                    "down": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 1048575 } },
                    "left": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 1048575 } },
                    "right": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 1048575 } },
                    "up": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 1048575 } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
