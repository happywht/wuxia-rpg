{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuxia-rpg.invalid/schema/knowledge-nodes",
  "title": "知识图谱节点集",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "summary", "knownByDefault"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": {
            "type": "string",
            "enum": ["character", "place", "faction", "item", "martialArt", "event", "quest", "ending"]
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
          "knownByDefault": { "type": "boolean" }
        }
      }
    }
  }
}
