{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuxia-rpg.invalid/schema/npc-set",
  "title": "NPC 集合",
  "description": "NPC 集合 JSON 的静态结构契约：字段名、类型与取值范围。跨资源语义（mapResourceId/dialogueId 引用是否存在、坐标是否在地图内且可走、NPC 是否占用同一格、是否压住玩家出生点）由运行时的跨资源校验补足，schema 无法表达跨文件约束。",
  "type": "object",
  "additionalProperties": false,
  "required": ["npcs"],
  "properties": {
    "npcs": {
      "type": "array",
      "description": "NPC 条目列表；允许空数组表达当前地图无人可交互。id 在集合内应保持唯一。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "mapResourceId", "position", "dialogueId"],
        "properties": {
          "id": {
            "description": "稳定 NPC id，建议前缀 char.，如 char.shen-mohan。",
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*$"
          },
          "name": {
            "description": "NPC 显示名称（原创人物名）。",
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "mapResourceId": {
            "description": "NPC 所在地图的 manifest 资源 id，如 map.round-01-grid。",
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*$"
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": ["col", "row"],
            "properties": {
              "col": {
                "type": "integer",
                "minimum": 0
              },
              "row": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "dialogueId": {
            "description": "NPC 默认对话的 id，须存在于已加载的对话集合资源中；当 NPC 的 shopId 无效或商店被禁用时，交互回落到这段对话。",
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*$"
          },
          "shopId": {
            "description": "可选：该 NPC 经营的商店 id（Round 06）。玩家与 NPC 相邻按 E 打开该商店；引用须指向已装配的有效商店，坏引用回落到 dialogueId 对话并给出可读警告。",
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*$"
          },
          "questGiver": {
            "description": "可选：该 NPC 可发布任务（Round 07）。玩家与其相邻按 E 打开任务名录；缺省为 false。",
            "type": "boolean"
          },
          "spriteFrame": {
            "description": "可选：map art actor 图集中的零起始人物帧；缺省使用地图配置的默认 NPC 帧。",
            "type": "integer",
            "minimum": 0,
            "maximum": 1048575
          },
          "spriteFrames": {
            "description": "可选：人物图集中朝下、左、右、上的静止帧；省略时沿用 spriteFrame 静态帧。",
            "type": "object",
            "additionalProperties": false,
            "required": ["down", "left", "right", "up"],
            "properties": {
              "down": { "type": "integer", "minimum": 0, "maximum": 1048575 },
              "left": { "type": "integer", "minimum": 0, "maximum": 1048575 },
              "right": { "type": "integer", "minimum": 0, "maximum": 1048575 },
              "up": { "type": "integer", "minimum": 0, "maximum": 1048575 }
            }
          },
          "schedule": {
            "description": "可选：按历法时段声明地图内位置（Round 16）；未声明当前时段时回到基础 position。",
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["periodId", "position"],
              "properties": {
                "periodId": {
                  "description": "日历时段 id，必须在必需的 game-calendar 资源中声明。",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*$"
                },
                "position": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["col", "row"],
                  "properties": {
                    "col": { "type": "integer", "minimum": 0 },
                    "row": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
