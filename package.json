{
  "name": "wuxia-rpg",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "原创中文武侠 RPG（数据优先架构；受文曲星系列掌上 RPG 广泛玩法原则启发的独立新作，不含任何原作内容）",
  "scripts": {
    "dev": "vite",
    "check": "npm run validate:data && npm run inspect:mods && npm run typecheck && npm test && npm run audit:round-34 && npm run audit:round-48-docs",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "package:release": "npm run build && node scripts/package-release.mjs && npm run smoke:round-47",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark:round-40": "node scripts/benchmark-round-40.mjs",
    "import:round-51-world": "node scripts/import-round51-kenney-world.mjs",
    "import:round-65-urban-town": "node scripts/import-round65-urban-town.mjs",
    "generate:round-66-atlas": "node scripts/generate-round66-atlas.mjs",
    "generate:round-67-salt-road": "node scripts/generate-round67-salt-road.mjs",
    "generate:round-55-ferry": "node scripts/generate-round55-ferry-world.mjs",
    "generate:round-62-iron-ridge": "node scripts/generate-round62-iron-ridge.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "inspect:mods": "node scripts/inspect-mods.mjs",
    "content:export": "node scripts/content-package.mjs export",
    "content:import": "node scripts/content-package.mjs import",
    "audit:round-34": "node scripts/audit-round-34-docs.mjs",
    "audit:round-48-docs": "node scripts/audit-round-48-docs.mjs",
    "audit:final": "node scripts/audit-final-acceptance.mjs",
    "smoke:round-20": "node scripts/smoke-round-20.mjs",
    "smoke:round-21": "node scripts/smoke-round-21.mjs",
    "smoke:round-22": "node scripts/smoke-round-22.mjs",
    "smoke:round-23": "node scripts/smoke-round-23.mjs",
    "smoke:round-24": "node scripts/smoke-round-24.mjs",
    "smoke:round-25": "node scripts/smoke-round-25.mjs",
    "smoke:round-26": "node scripts/smoke-round-26.mjs",
    "smoke:round-27": "node scripts/smoke-round-27.mjs",
    "smoke:round-28": "node scripts/smoke-round-28.mjs",
    "smoke:round-29": "node scripts/smoke-round-29.mjs",
    "smoke:round-30": "node scripts/smoke-round-30.mjs",
    "smoke:round-31": "node scripts/smoke-round-31.mjs",
    "smoke:round-32": "node scripts/smoke-round-32.mjs",
    "smoke:round-33": "node scripts/smoke-round-33.mjs",
    "smoke:round-35": "node scripts/smoke-round-35.mjs",
    "smoke:round-36": "node scripts/smoke-round-36.mjs",
    "smoke:round-37": "node scripts/smoke-round-37.mjs",
    "smoke:round-42": "vitest run tests/round42-story.test.ts",
    "smoke:round-43": "vitest run tests/world-map.test.ts tests/round43-faction-routes.test.ts",
    "smoke:round-44": "vitest run tests/world-map.test.ts tests/quest-system.test.ts tests/round44-dynamic-events.test.ts",
    "smoke:round-46": "vitest run tests/round46-vertical-slice.test.ts",
    "smoke:round-47": "node scripts/smoke-round-47.mjs",
    "smoke:round-68": "vitest run tests/round68-long-journey.test.ts",
    "smoke:round-69": "vitest run tests/round69-martial-paths.test.ts tests/round69-guard-combat.test.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "phaser": "^4.2.1"
