    "smoke:round-20": "node scripts/smoke-round-20.mjs",
    "smoke:round-21": "node scripts/smoke-round-21.mjs",
    "smoke:round-22": "node scripts/smoke-round-22.mjs",
    "smoke:round-23": "node scripts/smoke-round-23.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
